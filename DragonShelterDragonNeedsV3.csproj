<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DragonShelterDragonNeedsV3</AssemblyName>
    <Version>3.0.0</Version>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Dragon Shelter</GameDir>
    <ManagedDir>$(GameDir)\Dragon Shelter_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GenericServices"><HintPath>$(ManagedDir)\GenericServices.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Entities"><HintPath>$(ManagedDir)\Entities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Persistance"><HintPath>$(ManagedDir)\Persistance.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>

